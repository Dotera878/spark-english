rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ログインした本人だけが自分の学習記録を読み書きできる
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
